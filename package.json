    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "4.0.9",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "hast-util-to-string": "^3.0.1",
    "playwright": "1.58.2",
    "prettier": "^3.6.2",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
